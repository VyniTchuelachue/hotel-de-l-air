# Copy this file to server/.env and fill in what you need. Everything is optional.

PORT=4000

# Email notifications for new booking requests and contact messages.
# Without SMTP_HOST the notifications are only printed in the server console.
HOTEL_EMAIL=reservation@hotel-de-lair.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hôtel de l'Air <no-reply@hotel-de-lair.com>"

# Enables GET /api/admin/reservations and /api/admin/messages
# (send the header  Authorization: Bearer <ADMIN_TOKEN>).
ADMIN_TOKEN=

# Where reservations.json and messages.json are stored (default: server/data).
DATA_DIR=

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...).
TRUST_PROXY=

# Only if the React app is hosted on another domain, e.g. https://hotel-de-lair.com
CORS_ORIGIN=
